# ─────────────────────────────────────────────────────────────────────────────
# Fahm & Zaatar — environment. Everything is optional: with no values the demo
# runs on an embedded Postgres (PGlite) with mock payments/notifications.
# Copy to .env.local and fill in what you need.
# ─────────────────────────────────────────────────────────────────────────────

SITE_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Empty → embedded PGlite stored in PGLITE_DATA_DIR (auto-migrated + seeded).
# Supabase: use the pooled connection string (Project settings → Database).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
AUTO_SEED=true

# ── Supabase (Auth, Storage, Realtime) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local auth (only used without Supabase). 32+ random characters. ─────────
AUTH_SECRET=

# ── Payments ─────────────────────────────────────────────────────────────────
# mock = simulated Paymob checkout; sandbox/live = real Paymob Intention API.
PAYMENT_MODE=mock
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_FAWRY=
PAYMOB_INTEGRATION_VALU=

# ── WhatsApp notifications ──────────────────────────────────────────────────
# mock = logged to the notification_log table + server console.
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESTAURANT_ALERT_PHONE=01000000000
